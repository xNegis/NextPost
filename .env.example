POSTGRES_DB=nextpost
POSTGRES_USER=nextpost
POSTGRES_PASSWORD=nextpost-local-only
DATABASE_URL=postgresql+psycopg://nextpost:nextpost-local-only@db:5432/nextpost
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SESSION_SECRET=nextpost-session-secret-local-only
VITE_API_BASE_URL=http://localhost:8000

# Server-only secret that derives private consultation links. Provide a strong value (at least
# 32 bytes) in any shared or production environment; changing it invalidates every existing
# private link. The checked-in default is accepted only when APP_ENV=development.
PRIVATE_LINK_SECRET=nextpost-private-link-secret-local-only

# Server-side non-secret attribution label for the restricted RF-32 removal command. Deployment
# access is the authority; this value is never a product credential or frontend setting.
REMOVAL_OPERATOR_ID=local-operator

# Consultation and photo limits (startup-validated; a restart applies changes).
CONSULTATION_MIN_PHOTOS=2
CONSULTATION_MAX_PHOTOS=10
MAX_OPEN_CONSULTATIONS=3
PHOTO_MAX_INPUT_BYTES=15728640
PHOTO_MAX_PIXELS=40000000
PHOTO_MAX_OUTPUT_EDGE=2560

# Consultation question/context text limits (startup-validated; a restart applies changes).
CONSULTATION_QUESTION_MAX_LENGTH=120
CONSULTATION_CONTEXT_MAX_LENGTH=500

# Private photo storage and temporary-session cleanup.
PHOTO_STORAGE_ROOT=data/photos
PHOTO_LEASE_SECONDS=86400
PHOTO_CLEANUP_INTERVAL_SECONDS=3600
PHOTO_DELETION_ALERT_SECONDS=86400
